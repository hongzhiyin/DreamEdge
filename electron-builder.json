{
  "appId": "io.github.hongzhiyin.dreamedge",
  "productName": "DreamEdge",
  "directories": { "output": "release" },
  "files": ["dist/app.json", "dist/desktop/**/*", "dist/shell/**/*", "dist/tools/**/*", "package.json", "!node_modules/@capacitor/**"],
  "asar": true,
  "asarUnpack": ["node_modules/esbuild/**", "node_modules/@esbuild/**"],
  "npmRebuild": false,
  "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
  "mac": {
    "category": "public.app-category.productivity",
    "identity": "-",
    "target": ["dmg", "zip"]
  },
  "win": { "target": ["nsis"] },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "deleteAppDataOnUninstall": false
  }
}
