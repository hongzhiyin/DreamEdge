{
  "name": "dreamedge",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "main": "dist/desktop/main.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build:core": "tsc -p tsconfig.json",
    "build:ui": "esbuild desktop/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/desktop/preload.cjs && vite build --config renderer/vite.config.ts",
    "build": "npm run build:core && npm run build:ui",
    "start": "npm run build && electron .",
    "test": "npm run build:core && node --test dist/test/*.test.js",
    "test:ui": "npm run build && node --test --test-concurrency=1 dist/test/ui/*.test.js",
    "package:app": "npm run build && node dist/scripts/package-application.js",
    "start:packaged": "node dist/scripts/run-packaged.js",
    "test:packaged": "node dist/scripts/test-packaged.js",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json",
    "model:check": "npm run build:core && node dist/scripts/model-check.js",
    "model:integration": "npm run build:core && node dist/scripts/deepseek-integration.js",
    "tools:integration": "npm run build:core && node dist/scripts/tool-integration.js",
    "files:integration": "npm run build:core && node dist/scripts/file-integration.js"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "overrides": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-codemode": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@earendil-works/chord": "1.1.0"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1-rc.1",
    "@deepseek-ai/dsh-fs": "0.0.1-rc.1",
    "@deepseek-ai/dsh-fs-local": "0.0.1-rc.1",
    "@deepseek-ai/dsh-llm": "0.0.1-rc.1",
    "@deepseek-ai/dsh-timeout": "0.0.1-rc.1",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@vscode/ripgrep": "1.18.0",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@electron/packager": "20.3.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
